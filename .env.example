HTTP_ADDRESS=:8080
MONGO_URI='mongodb://localhost:27017/?replicaSet=rs0&directConnection=true'
MONGO_DATABASE=standard-setting
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DATABASE=0
JWT_SECRET=replace-with-at-least-32-random-characters
INITIAL_PASSWORD=12345*
CORS_ORIGINS=http://localhost:5176
# Safe startup defaults; production requires private JWT_SECRET and INITIAL_PASSWORD.
APP_ENV=development
SEED_DEMO_ITEMS=false
# Comma-separated addresses of the reverse proxies you control; empty = trust none.
TRUSTED_PROXIES=
